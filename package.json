    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  }
