    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
